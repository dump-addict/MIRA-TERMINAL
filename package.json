{
  "name": "mira-terminal",
  "productName": "Mira Terminal",
  "version": "0.1.3",
  "private": true,
  "description": "The map of your project, and one coding agent per branch",
  "license": "MIT",
  "author": "Mira Foundry",
  "homepage": "https://github.com/mira-foundry/mira-terminal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mira-foundry/mira-terminal.git"
  },
  "bugs": {
    "url": "https://github.com/mira-foundry/mira-terminal/issues"
  },
  "keywords": [
    "terminal",
    "electron",
    "coding-agents",
    "claude-code",
    "codex",
    "gemini-cli",
    "architecture-map"
  ],
  "main": "./out/main/index.js",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "pnpm typecheck && pnpm build && node scripts/check-syntax.mjs",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --x64 --publish never"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron-updater": "^6.8.11",
    "monaco-editor": "0.52.2",
    "node-pty": "1.1.0",
    "qrcode": "1.5.4",
    "sherpa-onnx-node": "2.0.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/qrcode": "1.5.5",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "43.8.10",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^0.577.0",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  },
  "build": {
    "appId": "dev.mira.terminal",
    "productName": "Mira Terminal",
    "copyright": "Copyright © 2026 Mira Terminal contributors",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/monaco-editor/**",
      "!node_modules/@xterm/**",
      "!node_modules/zustand/**",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "skill/miraterminal",
        "to": "skill/miraterminal",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/sherpa-onnx-*/**",
      "**/node_modules/sherpa-onnx-node/**"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "minimumSystemVersion": "13.0",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Mira Terminal uses the microphone for dictation. Audio is transcribed on this Mac and never leaves it.",
        "NSAppleEventsUsageDescription": "Mira Terminal opens your project folders in the apps you choose."
      },
      "artifactName": "Mira-Terminal-macos-${arch}.${ext}"
    },
    "dmg": {
      "title": "Mira Terminal",
      "artifactName": "Mira-Terminal-macos-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "artifactName": "Mira-Terminal-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Mira-Terminal-windows-${arch}.${ext}",
      "shortcutName": "Mira Terminal"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "Development",
      "executableName": "mira-terminal",
      "synopsis": "The terminal for all your projects",
      "artifactName": "Mira-Terminal-linux-x64.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mira-foundry",
        "repo": "mira-terminal",
        "releaseType": "draft"
      }
    ]
  }
}
